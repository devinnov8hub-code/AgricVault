# ===========================================================================
# AgriVault environment
#
# Copy to .env and fill in. Vite only reads .env at STARTUP — restart the dev
# server after any change, or you will keep seeing the old value.
#
#   cp .env.example .env              (PowerShell: copy .env.example .env)
#
# Windows note: if you edit this with PowerShell redirection it may be saved as
# UTF-16. The scripts cope with that, but saving as UTF-8 avoids surprises.
# ===========================================================================

# ---------------------------------------------------------------------------
# Firebase web config — CLIENT SIDE
#
# These are bundled into the browser build and that is fine: Firebase web
# config is public by design. Firestore security rules are what protect your
# data, not these values.
#
# Where: Firebase Console → Project settings → General → Your apps → Web app
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyA4HGE-BCftp5kDeYR8qST3IQxv5pp2AVg
VITE_FIREBASE_AUTH_DOMAIN=agrivault-1a19d.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://agrivault-1a19d-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=agrivault-1a19d
VITE_FIREBASE_STORAGE_BUCKET=agrivault-1a19d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=872106099104
VITE_FIREBASE_APP_ID=1:872106099104:web:63be40a219ca6d1533e4c5
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# SERVER SIDE — secret. Never prefix any of these with VITE_.
#
# Anything with VITE_ is compiled into the JavaScript every visitor downloads.
# These must not be.
# ---------------------------------------------------------------------------

# The service account, for `npm run seed` and the /api routes.
#
# EASIEST: do not set either of these. Download the key from
#   Firebase Console → Project settings → Service accounts → Generate new private key
# and drop the .json file next to package.json. The seed script finds it, and
# .gitignore already excludes it.
#
# Or name the file explicitly:
# FIREBASE_SERVICE_ACCOUNT_PATH=./agrivault-1a19d-firebase-adminsdk.json
#
# Or paste the whole JSON on ONE line. This is what VERCEL needs, since there is
# no file to point at there.
# This credential bypasses every security rule. Treat it like the password to
# your whole project, and never give it a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT=

# Realtime Database, for the IoT bridge.
FIREBASE_DB_URL=https://agrivault-1a19d-default-rtdb.europe-west1.firebasedatabase.app

# Resend, for receipts and reminders. https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=AgriVault <onboarding@resend.dev>
RESEND_REPLY_TO=

# Any long random string. Guards /api/sync-readings so only your scheduler can
# call it. Generate one with:  openssl rand -hex 32
SYNC_KEY=

# Who may call the API routes from a browser. Add your Vercel URL after deploy.
ALLOWED_ORIGINS=http://localhost:5173
